<Window x:Class="TraderPen.NameInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar aula"
        Width="380" Height="180"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="#1C1C1E">
    <StackPanel Margin="18">
        <TextBlock Text="Nome da aula" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,4"/>
        <TextBlock Text="Vai criar uma pasta com esse nome em Documentos\TraderPen contendo o PNG de cada aba salva."
                   FontSize="11" Foreground="#9A9A9A" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBox x:Name="NameTextBox" FontSize="14" Padding="6" Background="#2A2A2A" Foreground="#E0E0E0"
                 BorderBrush="#3A3A3A" BorderThickness="1" KeyDown="NameTextBox_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Width="84" Height="30" Margin="0,0,8,0" Click="Cancel_Click"
                    Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#3A3A3A"/>
            <Button Content="Exportar" Width="84" Height="30" Click="Ok_Click" IsDefault="True"
                    Background="#005A9E" Foreground="White" BorderBrush="#005A9E"/>
        </StackPanel>
    </StackPanel>
</Window>
